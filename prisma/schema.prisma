// ─── Order Status ─────────────────────────────────────────────────────────────

model OrderStatus {
  id              String           @id @default(uuid())
  name            String           @unique
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  snapVendorItems SnapVendorItem[]
  snapBonuses     SnapBonus[]

  @@map("order_statuses")
}

// ─── Client Agreement ─────────────────────────────────────────────────────────

model ClientAgreement {
  id         String          @id @default(uuid())
  bookingId  String          @unique
  token      String          @unique
  accessCode String
  status     AgreementStatus @default(Pending)
  sentAt     DateTime?
  viewedAt   DateTime?
  signedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("client_agreements")
}

// ─── Approval Flow Config (DB-driven, replaces hardcoded lib/approval-flows.ts) ─

model ApprovalFlowConfig {
  id         String             @id @default(uuid())
  module     String             @unique // "booking", "package", "quotations", "catering", "decoration", "payment"
  label      String? // human-readable display name
  sequential Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  steps      ApprovalFlowStep[]

  @@map("approval_flow_configs")
}

model ApprovalFlowStep {
  id             String             @id @default(uuid())
  flowId         String
  stepOrder      Int
  approverRoleId String
  label          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  flow           ApprovalFlowConfig @relation(fields: [flowId], references: [id], onDelete: Cascade)
  approverRole   Role               @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)

  @@unique([flowId, stepOrder])
  @@index([flowId])
  @@index([approverRoleId])
  @@map("approval_flow_steps")
}

// ─── Approval Records ──────────────────────────────────────────────────────

model ApprovalRecord {
  id               String               @id @default(uuid())
  module           String
  entityId         String
  status           String               @default("pending")
  emateraiSn       String?
  emateraiQrBase64 String?
  createdById      String
  updatedById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        Profile              @relation("ApprovalRecordCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        Profile?             @relation("ApprovalRecordUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  steps            ApprovalRecordStep[]

  @@unique([module, entityId])
  @@index([createdById])
  @@index([updatedById])
  @@index([module, status])
  @@map("approval_records")
}

model ApprovalRecordStep {
  id             String           @id @default(uuid())
  recordId       String
  stepOrder      Int
  approverType   String
  approverRoleId String?
  approverUserId String?
  status         String           @default("pending")
  signature      String?
  decidedById    String?
  decidedAt      DateTime?
  notes          String?
  revisionId     String?
  createdAt      DateTime         @default(now())
  record         ApprovalRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  approverRole   Role?            @relation("ApprovalRecordStepRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  approverUser   Profile?         @relation("ApprovalRecordStepApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decidedBy      Profile?         @relation("ApprovalRecordStepDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  revision       BookingRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([recordId])
  @@index([approverRoleId])
  @@index([approverUserId])
  @@index([decidedById])
  @@index([revisionId])
  @@map("approval_record_steps")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  isMention  Boolean  @default(false)
  commentId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([userId, isMention, isRead])
  @@map("notifications")
}

model EventType {
  id         String        @id @default(uuid())
  name       String // e.g. "Resepsi", "Akad & Resepsi", "Halfday 6hrs"
  code       String        @unique // e.g. "R", "AR", "H6" — used in PO number
  category   EventCategory @default(WEDDINGS)
  sortOrder  Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  leads      DailyActivity[]
  quotations Quotation[]

  @@index([category])
  @@map("event_types")
}

model Counter {
  id    String @id // e.g. "invoice-2026"
  value Int    @default(0)

  @@map("counters")
}

// ─── CRM: Leads ──────────────────────────────────────────────────────────────

enum EventCategory {
  WEDDINGS
  MICE
}

enum MiceItemPriceType {
  PAX
  NOMINAL
}

model LeadStatus {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6b7280")
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  isFinal   Boolean  @default(false)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     DailyActivity[]

  @@index([sortOrder])
  @@map("lead_statuses")
}

model DailyActivitySegment {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     DailyActivity[]

  // Physical table kept as "lead_segments" — no data migration needed.
  @@index([sortOrder])
  @@map("lead_segments")
}

model DailyActivity {
  id             String    @id @default(uuid())
  name           String
  contactNumbers Json      @default("[]") // Array of { label: string, number: string }
  email          String?
  emailCpp       String? // Email Contact Person Pria (wedding)
  emailCpw       String? // Email Contact Person Wanita (wedding)
  nikCpp         String? // NIK Calon Pengantin Pria (wedding)
  nikCpw         String? // NIK Calon Pengantin Wanita (wedding)
  addressCpp     String? // Alamat Calon Pengantin Pria (wedding)
  addressCpw     String? // Alamat Calon Pengantin Wanita (wedding)
  address        String?
  eventDate      DateTime?
  eventDateAlt   DateTime? // Tanggal alternatif jika ada
  time           String?
  estimatedPax   Int?
  budgetRange    String?
  notes          String?

  category          EventCategory   @default(WEDDINGS)
  weddingSession    WeddingSession?
  weddingSessionAlt WeddingSession? // Session untuk tanggal alternatif (per-date session)

  bitrixId  String?
  instansi  String? // DEPRECATED: legacy free-text segment (MICE). Digantikan segmentId; masih dibaca sebagai fallback sampai kolom di-drop.
  segmentId String? // FK ke DailyActivitySegment (MICE segment ternormalisasi)

  // MICE prospecting fields (dipindah dari Google Sheet "Daily Activity MICE")
  instagramUrl  String? // handle/username ATAU full URL IG prospek — disimpan apa adanya
  siteVisitDate DateTime? // jadwal kunjungan venue (site visit)

  // Date locking (booking fee)
  isDateLocked          Boolean   @default(false)
  bookingFeeAmount      Int? // nominal booking fee dalam rupiah (Int, konsisten dengan TermOfPayment.amount)
  bookingFeeDate        DateTime? // tanggal terima booking fee
  bookingFeeEvidenceUrl String? // S3/MinIO key/URL bukti bayar

  // FK relations
  venueId               String?
  venueSecondaryId      String? // venue cadangan / secondary
  packageId             String?
  eventTypeId           String?
  sourceOfInformationId String?
  statusId              String
  createdById           String
  assignedToId          String?

  // Conversion tracking (populated when Deal status reached and lead is converted)
  convertedAt           DateTime?
  convertedToCustomerId String?
  convertedToBookingId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue               Venue?               @relation("LeadPrimaryVenue", fields: [venueId], references: [id], onDelete: SetNull)
  venueSecondary      Venue?               @relation("LeadSecondaryVenue", fields: [venueSecondaryId], references: [id], onDelete: SetNull)
  package             Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  eventType           EventType?           @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  sourceOfInformation SourceOfInformation? @relation(fields: [sourceOfInformationId], references: [id], onDelete: SetNull)
  segment             DailyActivitySegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  status              LeadStatus           @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy           Profile              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo          Profile?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedToCustomer Customer?            @relation("LeadConvertedCustomer", fields: [convertedToCustomerId], references: [id], onDelete: SetNull)
  convertedToBooking  Booking?             @relation("LeadConvertedBooking", fields: [convertedToBookingId], references: [id], onDelete: SetNull)
  bookingsFromLead    Booking[]            @relation("BookingFromLead")

  @@index([statusId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([eventDate])
  @@index([venueId])
  @@index([venueSecondaryId])
  @@index([segmentId])
  @@index([isDateLocked])
  // Composite index buat availability check: cari locked leads per venue+date+session
  @@index([venueId, eventDate, weddingSession, isDateLocked])
  // Composite index buat alt-date availability check: cari locked leads per venue+altDate+sessionAlt
  @@index([venueId, eventDateAlt, weddingSessionAlt, isDateLocked])
  @@map("leads")
}

model UserTarget {
  id        String   @id @default(uuid())
  profileId String
  type      String   @default("sales") // sales, collection, revenue, etc.
  year      Int
  amount    BigInt
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation("UserTargets", fields: [profileId], references: [id], onDelete: Cascade)
  setBy   Profile @relation("UserTargetsSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([profileId, type, year])
  @@index([profileId])
  @@index([setById])
  @@index([type])
  @@map("user_targets")
}

// ─── Quotation ────────────────────────────────────────────────────────────────

enum QuotationStatus {
  draft
  sent
  revised
  accepted
  rejected
}

model Quotation {
  id          String          @id @default(uuid())
  quotationNo String?
  category    EventCategory   @default(WEDDINGS)
  status      QuotationStatus @default(draft)

  // Client info
  clientName  String
  clientPhone String
  instansi    String?

  // Relations
  salesId         String
  venueId         String?
  eventTypeId     String?
  paymentMethodId String?
  // Snapshot of names at creation time (for display/PDF without JOIN)
  eventTypeName   String?
  venueName       String?

  // Event
  weddingSession WeddingSession?
  eventDate      DateTime?
  time           String?
  place          String? // Area/ruang venue (mis. Ballroom, Outdoor, Gazebo)
  details        String?

  // Pricing (server-computed)
  subtotal   Int  @default(0)
  discount   Int  @default(0)
  totalPrice Int  @default(0)
  // Booking fee required to confirm the reservation (shown in the Term & Payment
  // boilerplate: "Booking Fee of Rp X is required to confirm the reservation").
  bookingFee Int?

  // Meta
  validUntil      DateTime?
  notes           String?
  signingLocation String?
  signatureSales  String? // base64 data URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales         Profile        @relation(fields: [salesId], references: [id], onDelete: Restrict)
  venue         Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  eventType     EventType?     @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  items QuotationItem[]
  terms QuotationTerm[]

  @@index([salesId])
  @@index([venueId])
  @@index([eventTypeId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(uuid())
  quotationId String
  title       String
  description String? // rich HTML from TipTap
  qty         Int      @default(0)
  price       Int      @default(0)
  total       Int      @default(0)
  manualTotal Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationTerm {
  id              String    @id @default(uuid())
  quotationId     String
  name            String
  amount          Int
  dueDate         DateTime?
  sortOrder       Int       @default(0)
  paymentStatus   String    @default("unpaid")
  paymentEvidence String? // R2 key for payment proof (required when paid)
  createdAt       DateTime  @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_terms")
}

// ── Quotation Template (per venue) ──────────────────────────────────────────────
// Reusable default line items + default payment method, auto-loaded into the
// quotation form when a venue is selected.
model QuotationTemplate {
  id              String   @id @default(uuid())
  venueId         String   @unique // one template per venue
  paymentMethodId String?
  bookingFee      Int? // default booking fee auto-loaded into the quotation form
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  venue         Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod?          @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items         QuotationTemplateItem[]

  @@index([paymentMethodId])
  @@map("quotation_templates")
}

model QuotationTemplateItem {
  id          String  @id @default(uuid())
  templateId  String
  title       String
  description String? // rich HTML (TipTap)
  qty         Int     @default(0)
  price       Int     @default(0)
  total       Int     @default(0)
  manualTotal Boolean @default(false)
  sortOrder   Int     @default(0)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("quotation_template_items")
}

// ─── Maintenance ─────────────────────────────────────────────────────────────

enum MaintenanceType {
  TICKET
  PREVENTIVE
}

model MaintenanceCategory {
  id        String              @id @default(uuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  tickets   MaintenanceTicket[]

  @@map("maintenance_categories")
}

model MaintenancePriority {
  id           String              @id @default(uuid())
  name         String              @unique
  deadlineDays Int
  createdAt    DateTime            @default(now())
  tickets      MaintenanceTicket[]

  @@map("maintenance_priorities")
}

model MaintenanceStatus {
  id        String              @id @default(uuid())
  name      String              @unique
  order     Int                 @default(0)
  createdAt DateTime            @default(now())
  tickets   MaintenanceTicket[]

  @@map("maintenance_statuses")
}

model MaintenanceTicket {
  id           String          @id @default(uuid())
  type         MaintenanceType @default(TICKET)
  description  String
  estimateDate DateTime?
  isVendor     Boolean         @default(false)
  isAudit      Boolean         @default(false)

  venueId      String
  categoryId   String
  priorityId   String
  statusId     String
  assignedToId String?
  createdById  String

  frequency   String?
  nextDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  category   MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priority   MaintenancePriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  status     MaintenanceStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignedTo Profile?            @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  Profile             @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  images     MaintenanceImage[]

  @@index([venueId])
