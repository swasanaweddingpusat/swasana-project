generator client {
  provider      = "prisma-client-js"
  // native       → local dev (Windows/macOS)
  // debian-...   → Docker runtime (node:20-bookworm-slim)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // relationJoins → opt into relationLoadStrategy: "join" (single LATERAL JOIN
  // instead of one round-trip per relation). Huge win for deep-include reads over
  // the Neon HTTP adapter. Applied selectively on heavy read queries.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  profile       Profile?
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Profile & RBAC ──────────────────────────────────────────────────────────

model Profile {
  id             String  @id @default(uuid())
  userId         String  @unique
  email          String  @unique
  employeeNumber Int     @unique @default(autoincrement())
  fullName       String?
  nickName       String?
  gender         Gender?
  phoneNumber    String?
  avatarUrl      String?

  // Personal data
  nik              String?
  kkNumber         String?
  placeOfBirth     String?
  dateOfBirth      DateTime?
  ktpAddress       String?
  currentAddress   String?
  city             String?
  motherName       String?
  maritalStatus    String?
  numberOfChildren Int?
  lastEducation    String?

  // Signature
  defaultSignature  String?  // base64 data URL PNG, tanda tangan default sales

  // Payroll
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?

  // Emergency contact
  emergencyContactName  String?
  emergencyContactRel   String?
  emergencyContactPhone String?

  // HR Employment
  npwp                  String?
  bpjsKesehatan         String?
  bpjsKetenagakerjaan   String?
  religion              Religion?
  bloodType             String?
  joinDate              DateTime?
  resignDate            DateTime?
  employmentType        EmploymentType?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  departmentId          String?
  positionId            String?
  ptkpStatus            PtkpStatus?

  // Access control
  roleId    String?
  managerId String?
  dataScope DataScope     @default(own)
  status    ProfileStatus @default(active)

  // Metadata
  invitedBy          String?
  invitedAt          DateTime?
  isEmailVerified    Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  language           String    @default("id")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  activityLogs            ActivityLog[]
  role                    Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager                 Profile?                   @relation("ProfileManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates            Profile[]                  @relation("ProfileManager")
  dataGroupMemberships    UserGroupMember[]
  ledGroups               UserGroup[]                @relation("GroupLeader")
  bookingsAsSales         Booking[]                  @relation("BookingSales")
  bookingsAsManager       Booking[]                  @relation("BookingManager")
  uploadedDocuments       BookingDocument[]
  createdSettlements      BookingPaymentSettlement[]
  notifications           Notification[]
  bookingComments         BookingComment[]
  bookingCommentReads     BookingCommentRead[]
  approvalRecordsCreated  ApprovalRecord[]           @relation("ApprovalRecordCreator")
  approvalRecordsUpdated  ApprovalRecord[]           @relation("ApprovalRecordUpdater")
  approvalStepApprovals   ApprovalRecordStep[]       @relation("ApprovalRecordStepApprover")
  approvalStepDecisions   ApprovalRecordStep[]       @relation("ApprovalRecordStepDecider")
  bookingRevisions         BookingRevision[]
  userTargets              UserTarget[]               @relation("UserTargets")
  userTargetsSet           UserTarget[]               @relation("UserTargetsSetBy")
  leadsCreated             Lead[]
  leadsAssigned            Lead[]          @relation("LeadAssignee")
  quotations               Quotation[]
  termOfPaymentsAcknowledged TermOfPayment[] @relation("TOPAcknowledger")
  maintenanceTicketsAssigned MaintenanceTicket[] @relation("MaintenanceAssignee")
  maintenanceTicketsCreated  MaintenanceTicket[] @relation("MaintenanceCreator")
  bookingEditDrafts          BookingEditDraft[]
  attendances                Attendance[]
  department             Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position               Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  departmentsHeaded      Department[]         @relation("DepartmentHead")
  employeeDocuments      EmployeeDocument[]
  uploadedEmployeeDocs   EmployeeDocument[]   @relation("DocumentUploader")
  employmentHistories    EmploymentHistory[]
  createdHistoryEntries  EmploymentHistory[]  @relation("HistoryCreator")
  workAssignments        EmployeeWorkAssignment[]
  shiftOverrides         ShiftOverride[]
  shiftOverridesCreated  ShiftOverride[]      @relation("ShiftOverrideCreator")
  leaveBalances             LeaveBalance[]
  leaveRequests             LeaveRequest[]
  leaveManagerApprovals     LeaveRequest[]  @relation("LeaveManagerApprover")
  leaveHrApprovals          LeaveRequest[]  @relation("LeaveHrApprover")
  leaveRejections           LeaveRequest[]  @relation("LeaveRejector")
  employeeSalaries          EmployeeSalary[]
  payslips                  Payslip[]
  payrollsGenerated         PayrollPeriod[] @relation("PayrollGenerator")
  payrollsFinalized         PayrollPeriod[] @relation("PayrollFinalizer")
  jobPostingsCreated        JobPosting[]    @relation("JobPostingCreator")
  hiredFromCandidate        Candidate[]     @relation("HiredCandidate")
  candidateNotesCreated     CandidateNote[] @relation("CandidateNoteCreator")
  onboardingAssignments     OnboardingAssignment[]
  onboardingTasksCompleted  OnboardingTask[] @relation("OnboardingTaskCompleter")
  procurementItemsCreated    ProcurementItem[]   @relation("ProcurementCreator")
  procurementItemsApproved   ProcurementItem[]   @relation("ProcurementApprover")
  procurementAnnouncements   ProcurementAnnouncement[] @relation("ProcurementAnnouncementCreator")
  attendances                Attendance[]
  leaveRequests              LeaveRequest[]
  leaveBalances              LeaveBalance[]
  payrollRecords             PayrollRecord[]
  onboardings                EmployeeOnboarding[]

  @@index([roleId])
  @@index([managerId])
  @@index([dataScope])
  @@index([departmentId])
  @@index([positionId])
  @@map("profiles")
}

model Role {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?
  sortOrder           Int                  @default(0)
  isSystemRole        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  profiles            Profile[]
  rolePermissions     RolePermission[]
  approvalRecordSteps ApprovalRecordStep[] @relation("ApprovalRecordStepRole")
  approvalFlowSteps   ApprovalFlowStep[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  description     String?
  moduleSortOrder Int              @default(0)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  profileId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("email_verification_tokens")
}

// ─── Data Groups (untuk scope = 'group') ─────────────────────────────────────

model UserGroup {
  id          String            @id @default(uuid())
  name        String
  description String?
  leaderId    String?
  sortOrder   Int               @default(0)
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leader      Profile?          @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members     UserGroupMember[]

  @@index([leaderId])
  @@map("user_groups")
}

model UserGroupMember {
  groupId   String
  userId    String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

// ─── Venue (dipakai untuk user invitation — assign venue ke user) ─────────────

model Brand {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  createdAt        DateTime @default(now())
  venues           Venue[]

  @@map("brands")
}

model Venue {
  id              String            @id @default(uuid())
  name            String
  description     String?
  address         String?
  capacity        Int?
  imageUrl        String?
  code            String            @default("KODE")
  brandId         String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  brand           Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  packages           Package[]
  paymentMethods     PaymentMethod[]
  bookings           Booking[]
  leads              Lead[]          @relation("LeadPrimaryVenue")
  leadsSecondary     Lead[]          @relation("LeadSecondaryVenue")
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  maintenanceTickets MaintenanceTicket[]
  workLocations      WorkLocation[]
  procurementItems   ProcurementItem[]

  @@index([brandId])
  @@map("venues")
}

// ─── Audit Logging ───────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  result      String   @default("success")
  entityType  String
  entityId    String
  changes     Json     @default("{}")
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  profile     Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

// ─── Vendors ─────────────────────────────────────────────────────────────────

model VendorCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendors     Vendor[]

  @@map("vendor_categories")
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  categoryId     String
  description    String?
  phone          String?
  address        String?
  bankName       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       VendorCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethods PaymentMethod[]

  @@index([categoryId])
  @@map("vendors")
}

model PaymentMethod {
  id                String                     @id @default(uuid())
  vendorId          String?
  venueId           String?
  bankName          String
  bankAccountNumber String
  bankRecipient     String
  createdAt         DateTime                   @default(now())
  vendor            Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  venue             Venue?                     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  settlements        BookingPaymentSettlement[]
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  termOfPayments     TermOfPayment[]

  @@index([vendorId])
  @@index([venueId])
  @@map("payment_methods")
}

// ─── Packages ────────────────────────────────────────────────────────────────

model Package {
  id               String                  @id @default(uuid())
  packageName      String
  available        Boolean                 @default(true)
  approvalStatus   String                  @default("draft")
  venueId          String?
  notes            String?
  pax              Int                     @default(0)
  margin           Float                   @default(0)
  sellingPrice     Int                     @default(0)
  termAndCondition String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  venue            Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  vendorItems      PackageVendorItem[]
  internalItems    PackageInternalItem[]
  categoryPrices   PackageCategoryPrice[]
  bookings         Booking[]
  leads            Lead[]

  @@index([venueId])
  @@map("packages")
}

// Global category master — shared across all packages. categoryName columns on
// the rows below are kept for back-compat/backfill but matching is now by categoryId.
model Category {
  id             String                 @id @default(uuid())
  name           String                 @unique
  sortOrder      Int                    @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  categoryPrices PackageCategoryPrice[]
  vendorItems    PackageVendorItem[]

  @@map("categories")
}

model PackageCategoryPrice {
  id           String    @id @default(uuid())
  packageId    String
  categoryId   String?
  categoryName String
  basePrice    Int       @default(0)
  sortOrder    Int       @default(0)
  isShow       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([categoryId])
  @@map("package_category_prices")
}

model PackageVendorItem {
  id           String    @id @default(uuid())
  packageId    String
  categoryId   String?
  categoryName String
  itemText     String
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([categoryId])
  @@map("package_vendor_items")
}

model PackageInternalItem {
  id              String   @id @default(uuid())
  packageId       String
  itemName        String
  itemDescription String   @default("")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  package         Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_internal_items")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id           String    @id @default(uuid())
  name         String
  mobileNumber Json      @default("[]")
  emailCpp     String?
  emailCpw     String?
  cppNik       String?
  cpwNik       String?
  ktpAddress   String?
  cppAddress   String?
  cpwAddress   String?
  type         String
  club         String?
  memberStatus String    @default("Non-Member")
  notes        String?
  bitrixId     String?
  sourceOfInformationId String?
  updatedBy             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  bookings              Booking[]
  sourceOfInformation   SourceOfInformation? @relation(fields: [sourceOfInformationId], references: [id], onDelete: SetNull)
  convertedFromLeads    Lead[]               @relation("LeadConvertedCustomer")

  @@index([name])
  @@map("customers")
}

// ─── Customer Member Status ───────────────────────────────────────────────────

model CustomerMemberStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("customer_member_statuses")
}

// ─── Source of Information ────────────────────────────────────────────────────

model SourceOfInformation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  bookings  Booking[]
  customers Customer[]
  leads     Lead[]

  @@map("source_of_informations")
}

model EducationLevel {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("education_levels")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProfileStatus {
  active
  inactive
  suspended
}

enum Gender {
  MALE
  FEMALE
}

enum DataScope {
  own
  group
  all
}

enum AttendanceStatus {
  on_time
  late
  absent
  on_leave
}

enum LeaveRequestStatus {
  pending
  manager_approved
  approved
  rejected
  cancelled
}

enum SalaryComponentType {
  earning
  deduction
}

enum SalaryComponentCategory {
  basic
  allowance
  deduction
  benefit
}

enum Pph21Method {
  ter
  progressive
}

enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

enum PayrollPeriodStatus {
  draft
  processing
  finalized
  paid
}

enum PayslipStatus {
  draft
  finalized
}

enum JobPostingStatus {
  draft
  open
  closed
}

enum CandidateStage {
  applied
  screening
  interview
  assessment
  offering
  hired
  rejected
}

enum OnboardingAssignTo {
  employee
  hr
  manager
}

enum OnboardingStatus {
  in_progress
  completed
}

enum Religion {
  islam
  kristen
  katolik
  hindu
  buddha
  konghucu
}

enum EmploymentType {
  permanent
  contract
  probation
  intern
}

enum ProcurementStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ProcurementDivision {
  HR
  OPERATIONAL
  IT
  FINANCE
  MICE
}

enum ProcurementEventType {
  WEDDING
  NON_WEDDING
}

enum ProcurementAnnouncementTarget {
  ALL
  VENUE
  DIVISION
}

model Booking {
  id                    String               @id @default(uuid())
  bookingStatus         BookingStatus        @default(Pending)
  recordStatus          BookingRecordStatus  @default(saved)
  paymentStatus         String               @default("")
  category              EventCategory        @default(WEDDINGS)
  weddingSession        WeddingSession?
  weddingType           String?
  eventTime             String?
  notes                 String?
  poNumber              String?
  poYear                Int?
  poSeq                 Int?
  eventDate             DateTime? // required for saved bookings; null only during MICE draft steps
  quotationId           String?
  salesSignature        String?
  rejectionNotes        String?
  lostReason            String?
  signingLocation       String?
  withMaterai           Boolean              @default(false)
  discountName          String?
  discountAmount        Int                  @default(0)
  promoId               String?
  promoSnapshot         Json?                // snapshot of DiscountProgram at booking creation
  salesId               String
  managerId             String?
  customerId            String
  venueId               String
  packageId             String?
  paymentMethodId       String?
  sourceOfInformationId String?
  // When a booking draft was created from a lead (Deal flow), leadId is set.
  // This allows the availability endpoint to block the slot even for drafts
  // (only draft-from-lead blocks; manually created drafts do not).
  leadId                String?
  // Draft-only fields: persisted during multi-step form, cleared on finalize (kept as null for saved bookings)
  draftCategoryToggles  Json?                // { categoryName: string, isTakeout: boolean, takeoutNominal: number }[]
  draftComplimentaries  Json?                // { complimentaryId: string | null, name: string, price: number, isShowPrice: boolean, description: string | null, qty: number }[]
  draftInternalItems    Json?                // { itemName: string, itemDescription: string }[] — editable package internal items during draft
  draftVendorItems      Json?                // { categoryId: string | null, categoryName: string, itemText: string }[] — editable package vendor items during draft
  // Tracks the active revision for approval step filtering (snapshot approach)
  currentRevisionId     String?
  // Set when the client signs the agreement — freezes the snapshot layer (SnapCustomer,
  // internal items, pricing). After this, only vendor items stay editable (ops swap);
  // changing internal items / price / pax requires a new revision + re-approval.
  snapshotFrozenAt      DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  sales               Profile              @relation("BookingSales", fields: [salesId], references: [id], onDelete: Restrict)
  manager             Profile?             @relation("BookingManager", fields: [managerId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  venue               Venue                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  package             Package?             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  sourceOfInformation SourceOfInformation? @relation(fields: [sourceOfInformationId], references: [id], onDelete: SetNull)
  currentRevision     BookingRevision?     @relation("BookingCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  lead                Lead?                @relation("BookingFromLead", fields: [leadId], references: [id], onDelete: SetNull)
  promo               DiscountProgram?     @relation(fields: [promoId], references: [id], onDelete: SetNull)

  // Snapshot relations (1:1)
  snapCustomer       SnapCustomer?
  snapVenue          SnapVenue?
  snapPackage        SnapPackage?
  snapPackagePricing SnapPackagePricing?

  // Snapshot relations (1:many)
  snapPackageInternalItems  SnapPackageInternalItem[]
  snapPackageVendorItems    SnapPackageVendorItem[]
  snapPackageCategoryPrices SnapPackageCategoryPrice[]
  snapBonuses               SnapBonus[]
  snapVendorItems           SnapVendorItem[]
  snapComplimentaries       SnapComplimentary[]

  // Live relations
  termOfPayments    TermOfPayment[]
  bookingDocuments  BookingDocument[]
  bookingRefunds    BookingPaymentSettlement[] @relation("SourceSettlements")
  targetSettlements BookingPaymentSettlement[] @relation("TargetSettlements")
  clientAgreement   ClientAgreement?
  bookingComments   BookingComment[]
  commentReads      BookingCommentRead[]
  revisions         BookingRevision[]
  convertedFromLeads Lead[]                    @relation("LeadConvertedBooking")
  editDraft         BookingEditDraft?

  @@index([salesId])
  @@index([managerId])
  @@index([customerId])
  @@index([venueId])
  @@index([packageId])
  @@index([paymentMethodId])
  @@index([sourceOfInformationId])
  @@index([leadId])
  @@index([promoId])
  @@index([bookingStatus])
  @@index([recordStatus])
  @@index([category])
  @@index([eventDate])
  @@index([currentRevisionId])
  @@index([recordStatus, poYear, poSeq])
  @@map("bookings")
}

model BookingRevision {
  id             String   @id @default(uuid())
  bookingId      String
  revisionNumber Int
  reason         String?

  // Queryable fields
  packageId      String
  packageName    String
  pax            Int      @default(0)
  price          Int      @default(0)
  venueId        String
  venueName      String
  discountName   String?
  discountAmount Int      @default(0)

  // Full snapshot for PDF rendering
  snapshotData   Json

  createdById    String
  createdAt      DateTime @default(now())

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy      Profile  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvalSteps  ApprovalRecordStep[]
  currentForBookings Booking[] @relation("BookingCurrentRevision")

  @@unique([bookingId, revisionNumber])
  @@index([bookingId])
  @@index([createdById])
  @@map("booking_revisions")
}

model BookingEditDraft {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  editorProfileId String
  formState       Json
