generator client {
  provider        = "prisma-client-js"
  // native       → local dev (Windows/macOS)
  // debian-...   → Docker runtime (node:20-bookworm-slim)
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  // relationJoins → opt into relationLoadStrategy: "join" (single LATERAL JOIN
  // instead of one round-trip per relation). Huge win for deep-include reads over
  // the Neon HTTP adapter. Applied selectively on heavy read queries.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  profile       Profile?
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Profile & RBAC ──────────────────────────────────────────────────────────

model Profile {
  id             String  @id @default(uuid())
  userId         String  @unique
  email          String  @unique
  employeeNumber Int     @unique @default(autoincrement())
  fullName       String?
  nickName       String?
  gender         Gender?
  phoneNumber    String?
  avatarUrl      String?

  // Personal data
  nik              String?
  kkNumber         String?
  placeOfBirth     String?
  dateOfBirth      DateTime?
  ktpAddress       String?
  currentAddress   String?
  city             String?
  motherName       String?
  maritalStatus    String?
  numberOfChildren Int?
  lastEducation    String?

  // Signature
  defaultSignature String? // base64 data URL PNG, tanda tangan default sales

  // Payroll
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?

  // Emergency contact
  emergencyContactName  String?
  emergencyContactRel   String?
  emergencyContactPhone String?

  // HR Employment
  npwp                String?
  bpjsKesehatan       String?
  bpjsKetenagakerjaan String?
  religion            Religion?
  bloodType           String?
  joinDate            DateTime?
  resignDate          DateTime?
  employmentType      EmploymentType?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  departmentId        String?
  positionId          String?
  ptkpStatus          PtkpStatus?

  // Access control
  roleId    String?
  managerId String?
  dataScope DataScope     @default(own)
  status    ProfileStatus @default(active)

  // Metadata
  invitedBy          String?
  invitedAt          DateTime?
  isEmailVerified    Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  language           String    @default("id")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  activityLogs               ActivityLog[]
  role                       Role?                      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager                    Profile?                   @relation("ProfileManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates               Profile[]                  @relation("ProfileManager")
  dataGroupMemberships       UserGroupMember[]
  ledGroups                  UserGroup[]                @relation("GroupLeader")
  bookingsAsSales            Booking[]                  @relation("BookingSales")
  bookingsAsManager          Booking[]                  @relation("BookingManager")
  uploadedDocuments          BookingDocument[]
  createdSettlements         BookingPaymentSettlement[]
  notifications              Notification[]
  bookingComments            BookingComment[]
  bookingCommentReads        BookingCommentRead[]
  commentReactions           BookingCommentReaction[]
  approvalRecordsCreated     ApprovalRecord[]           @relation("ApprovalRecordCreator")
  approvalRecordsUpdated     ApprovalRecord[]           @relation("ApprovalRecordUpdater")
  approvalStepApprovals      ApprovalRecordStep[]       @relation("ApprovalRecordStepApprover")
  approvalStepDecisions      ApprovalRecordStep[]       @relation("ApprovalRecordStepDecider")
  bookingRevisions           BookingRevision[]
  userTargets                UserTarget[]               @relation("UserTargets")
  userTargetsSet             UserTarget[]               @relation("UserTargetsSetBy")
  leadsCreated               DailyActivity[]
  leadsAssigned              DailyActivity[]            @relation("LeadAssignee")
  quotations                 Quotation[]
  ledgersCreated             Ledger[]                   @relation("LedgerCreator")
  ledgersAcknowledged        Ledger[]                   @relation("LedgerAcknowledger")
  ledgersVoided              Ledger[]                   @relation("LedgerVoider")
  invoicesIssued             Invoice[]                  @relation("InvoiceIssuer")
  invoicesVoided             Invoice[]                  @relation("InvoiceVoider")
  paymentActivities          PaymentActivity[]          @relation("PaymentActivityActor")
  bookingsRecognized         Booking[]                  @relation("BookingRecognizer")
  maintenanceTicketsAssigned MaintenanceTicket[]        @relation("MaintenanceAssignee")
  maintenanceTicketsCreated  MaintenanceTicket[]        @relation("MaintenanceCreator")
  bookingEditDrafts          BookingEditDraft[]
  attendances                Attendance[]
  department                 Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position                   Position?                  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  departmentsHeaded          Department[]               @relation("DepartmentHead")
  employeeDocuments          EmployeeDocument[]
  uploadedEmployeeDocs       EmployeeDocument[]         @relation("DocumentUploader")
  employmentHistories        EmploymentHistory[]
  createdHistoryEntries      EmploymentHistory[]        @relation("HistoryCreator")
  workAssignments            EmployeeWorkAssignment[]
  shiftOverrides             ShiftOverride[]
  shiftOverridesCreated      ShiftOverride[]            @relation("ShiftOverrideCreator")
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  leaveManagerApprovals      LeaveRequest[]             @relation("LeaveManagerApprover")
  leaveHrApprovals           LeaveRequest[]             @relation("LeaveHrApprover")
  leaveRejections            LeaveRequest[]             @relation("LeaveRejector")
  employeeSalaries           EmployeeSalary[]
  payslips                   Payslip[]
  payrollsGenerated          PayrollPeriod[]            @relation("PayrollGenerator")
  payrollsFinalized          PayrollPeriod[]            @relation("PayrollFinalizer")
  jobPostingsCreated         JobPosting[]               @relation("JobPostingCreator")
  hiredFromCandidate         Candidate[]                @relation("HiredCandidate")
  candidateNotesCreated      CandidateNote[]            @relation("CandidateNoteCreator")
  onboardingAssignments      OnboardingAssignment[]
  onboardingTasksCompleted   OnboardingTask[]           @relation("OnboardingTaskCompleter")
  procurementItemsCreated    ProcurementItem[]          @relation("ProcurementCreator")
  procurementItemsApproved   ProcurementItem[]          @relation("ProcurementApprover")
  procurementAnnouncements   ProcurementAnnouncement[]  @relation("ProcurementAnnouncementCreator")
  procurementVenueBudgets    ProcurementVenueBudget[]   @relation("ProcurementBudgetUpdater")
  pushSubscriptions          PushSubscription[]
  evaluationsAsSpecialist    EventEvaluation[]          @relation("EvaluationSpecialist")
  weddingIndicators          WeddingIndicator[]         @relation("WeddingIndicatorCreator")
  employeeDevelopments       EmployeeDevelopment[]
  employeeCertifications     EmployeeCertification[]
  performanceReviews         PerformanceReview[]
  payablesSettled            BookingPayable[]           @relation("PayableSettler")
  payablesCreated            BookingPayable[]           @relation("PayableCreator")

  @@index([roleId])
  @@index([managerId])
  @@index([dataScope])
  @@index([departmentId])
  @@index([positionId])
  recruitmentRequestsCreated  RecruitmentRequest[] @relation("RecruitmentRequestCreator")
  recruitmentRequestsApproved1 RecruitmentRequest[] @relation("RecruitmentRequestApprover1")
  recruitmentRequestsApproved2 RecruitmentRequest[] @relation("RecruitmentRequestApprover2")
  guestbookHosted             GuestbookEntry[]     @relation("GuestbookHost")
  guestbookCreated            GuestbookEntry[]     @relation("GuestbookCreator")
  blacklistCreated            BlacklistEntry[]     @relation("BlacklistCreator")
  @@map("profiles")
}

model Role {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String?
  sortOrder           Int                  @default(0)
  isSystemRole        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  profiles            Profile[]
  rolePermissions     RolePermission[]
  approvalRecordSteps ApprovalRecordStep[] @relation("ApprovalRecordStepRole")
  approvalFlowSteps   ApprovalFlowStep[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  description     String?
  moduleSortOrder Int              @default(0)
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Auth Tokens ─────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  profileId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("email_verification_tokens")
}

// ─── Data Groups (untuk scope = 'group') ─────────────────────────────────────

model UserGroup {
  id          String            @id @default(uuid())
  name        String
  description String?
  leaderId    String?
  sortOrder   Int               @default(0)
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leader      Profile?          @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members     UserGroupMember[]

  @@index([leaderId])
  @@map("user_groups")
}

model UserGroupMember {
  groupId   String
  userId    String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

// ─── Venue (dipakai untuk user invitation — assign venue ke user) ─────────────

model Brand {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  venues    Venue[]

  @@map("brands")
}

model Venue {
  id                 String                   @id @default(uuid())
  name               String
  description        String?
  address            String?
  capacity           Int?
  imageUrl           String?
  code               String                   @default("KODE")
  brandId            String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  brand              Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  packages           Package[]
  paymentMethods     PaymentMethod[]
  bookings           Booking[]
  leads              DailyActivity[]          @relation("LeadPrimaryVenue")
  leadsSecondary     DailyActivity[]          @relation("LeadSecondaryVenue")
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  maintenanceTickets MaintenanceTicket[]
  workLocations      WorkLocation[]
  procurementItems   ProcurementItem[]
  procurementBudgets ProcurementVenueBudget[]
  eventEvaluations   EventEvaluation[]
  weddingIndicators  WeddingIndicator[]

  @@index([brandId])
  guestbookEntries       GuestbookEntry[]
  @@map("venues")
}

// ─── Audit Logging ───────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  result      String   @default("success")
  entityType  String
  entityId    String
  changes     Json     @default("{}")
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  profile     Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

model TutorialCategory {
  id        String           @id @default(uuid())
  name      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lessons   TutorialLesson[]

  @@map("tutorial_categories")
}

model TutorialLesson {
  id         String           @id @default(uuid())
  categoryId String
  title      String
  duration   String
  completed  Boolean          @default(false)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   TutorialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps      TutorialStep[]

  @@index([categoryId])
  @@map("tutorial_lessons")
}

model TutorialStep {
  id        String                 @id @default(uuid())
  lessonId  String
  title     String
  caption   String
  image     String?
  videoUrl  String?
  videoType String?
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  lesson    TutorialLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  documents TutorialStepDocument[]

  @@index([lessonId])
  @@map("tutorial_steps")
}

model TutorialStepDocument {
  id        String       @id @default(uuid())
  stepId    String
  name      String
  fileUrl   String
  mimeType  String?
  fileSize  Int?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  step      TutorialStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("tutorial_step_documents")
}

// ─── Vendors ─────────────────────────────────────────────────────────────────

model VendorCategory {
  id                String             @id @default(uuid())
  name              String             @unique
  description       String?
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  vendors           Vendor[]
  vendorEvaluations VendorEvaluation[]

  @@map("vendor_categories")
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  categoryId     String
  description    String?
  phone          String?
  address        String?
  bankName       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       VendorCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethods PaymentMethod[]

  @@index([categoryId])
  @@map("vendors")
}

model PaymentMethod {
  id                 String                     @id @default(uuid())
  vendorId           String?
  venueId            String?
  bankName           String
  bankAccountNumber  String
  bankRecipient      String
  createdAt          DateTime                   @default(now())
  vendor             Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  venue              Venue?                     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  settlements        BookingPaymentSettlement[]
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]
  ledgers            Ledger[]
  payables           BookingPayable[]

  @@index([vendorId])
  @@index([venueId])
  @@map("payment_methods")
}

// ─── Packages ────────────────────────────────────────────────────────────────

model Package {
  id               String                 @id @default(uuid())
  packageName      String
  category         EventCategory          @default(WEDDINGS)
  available        Boolean                @default(true)
  approvalStatus   String                 @default("draft")
  venueId          String?
  notes            String?
  pax              Int                    @default(0)
  margin           Float                  @default(0)
  sellingPrice     Int                    @default(0)
  termAndCondition String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  venue            Venue?                 @relation(fields: [venueId], references: [id], onDelete: SetNull)
  vendorItems      PackageVendorItem[]
  internalItems    PackageInternalItem[]
  miceItems        PackageMiceItem[]
  categoryPrices   PackageCategoryPrice[]
  bookings         Booking[]
  leads            DailyActivity[]

  @@index([venueId])
  @@index([category])
  @@map("packages")
}

// Global category master — shared across all packages. categoryName columns on
// the rows below are kept for back-compat/backfill but matching is now by categoryId.
model Category {
  id             String                 @id @default(uuid())
  name           String                 @unique
  sortOrder      Int                    @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  categoryPrices PackageCategoryPrice[]
  vendorItems    PackageVendorItem[]

  @@map("categories")
}

model PackageCategoryPrice {
  id           String    @id @default(uuid())
  packageId    String
  categoryId   String?
  categoryName String
  basePrice    Int       @default(0)
  sortOrder    Int       @default(0)
  isShow       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([categoryId])
  @@map("package_category_prices")
}

model PackageVendorItem {
  id           String    @id @default(uuid())
  packageId    String
  categoryId   String?
  categoryName String
  itemText     String
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  package      Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([categoryId])
  @@map("package_vendor_items")
}

model PackageInternalItem {
  id              String   @id @default(uuid())
  packageId       String
  itemName        String
  itemDescription String   @default("")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  package         Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_internal_items")
}

model PackageMiceItem {
  id              String            @id @default(uuid())
  packageId       String
  itemName        String
  itemDescription String            @default("")
  itemType        MiceItemPriceType @default(PAX)
  itemPrice       Int               @default(0)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package         Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_mice_items")
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id                    String               @id @default(uuid())
  name                  String
  mobileNumber          Json                 @default("[]")
  emailCpp              String?
  emailCpw              String?
  cppNik                String?
  cpwNik                String?
  cppIdType             String               @default("KTP")
  cpwIdType             String               @default("KTP")
  ktpAddress            String?
  cppAddress            String?
  cpwAddress            String?
  type                  String
  club                  String?
  memberStatus          String               @default("Non-Member")
  notes                 String?
  bitrixId              String?
  sourceOfInformationId String?
  updatedBy             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  bookings              Booking[]
  sourceOfInformation   SourceOfInformation? @relation(fields: [sourceOfInformationId], references: [id], onDelete: SetNull)
  convertedFromLeads    DailyActivity[]      @relation("LeadConvertedCustomer")

  @@index([name])
  @@map("customers")
}

// ─── Customer Member Status ───────────────────────────────────────────────────

model CustomerMemberStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("customer_member_statuses")
}

// ─── Source of Information ────────────────────────────────────────────────────

model SourceOfInformation {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  bookings  Booking[]
  customers Customer[]
  leads     DailyActivity[]

  @@map("source_of_informations")
}

model EducationLevel {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("education_levels")
}

