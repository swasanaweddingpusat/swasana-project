  @@map("maintenance_images")
}

// ─── HR Attendance ────────────────────────────────────────────────────────────

model Attendance {
  id        String   @id @default(uuid())
  profileId String
  date      DateTime

  clockInAt       DateTime?
  clockInPhotoUrl String?
  clockInLat      Float?
  clockInLng      Float?

  clockOutAt       DateTime?
  clockOutPhotoUrl String?
  clockOutLat      Float?
  clockOutLng      Float?

