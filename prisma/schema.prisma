// ─── Booking Enums ───────────────────────────────────────────────────────────

enum BookingRecordStatus {
  draft
  saved
}

enum BookingStatus {
  Pending
  Uploaded
  Confirmed
  Rejected
  Canceled
  Lost
}

enum WeddingSession {
  morning
  evening
  fullday
}

enum LedgerDirection {
  in
