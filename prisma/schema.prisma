model Booking {
  id                    String              @id @default(uuid())
  bookingStatus         BookingStatus       @default(Pending)
  recordStatus          BookingRecordStatus @default(saved)
  paymentStatus         String              @default("")
  category              EventCategory       @default(WEDDINGS)
  weddingSession        WeddingSession?
  weddingType           String?
  eventTime             String?
  notes                 String?
  poNumber              String?
  poYear                Int?
  poSeq                 Int?
  eventDate             DateTime? // required for saved bookings; null only during MICE draft steps
  quotationId           String?
  salesSignature        String?
  rejectionNotes        String?
  lostReason            String?
  cancelReason          String?
  signingLocation       String?
  withMaterai           Boolean             @default(false)
  discountName          String?
  discountAmount        Int                 @default(0)
  salesId               String?
  managerId             String?
  customerId            String
  venueId               String
  packageId             String?
  paymentMethodId       String?
  sourceOfInformationId String?
  // When a booking draft was created from a lead (Deal flow), leadId is set.
  // This allows the availability endpoint to block the slot even for drafts
  // (only draft-from-lead blocks; manually created drafts do not).
  leadId                String?
  // Draft-only fields: persisted during multi-step form, cleared on finalize (kept as null for saved bookings)
  draftCategoryToggles  Json? // { categoryName: string, isTakeout: boolean, takeoutNominal: number }[]
  draftComplimentaries  Json? // { complimentaryId: string | null, name: string, price: number, isShowPrice: boolean, description: string | null, qty: number }[]
  draftInternalItems    Json? // { itemName: string, itemDescription: string }[] — editable package internal items during draft
  draftVendorItems      Json? // { categoryId: string | null, categoryName: string, itemText: string }[] — editable package vendor items during draft
  // Tracks the active revision for approval step filtering (snapshot approach)
  currentRevisionId     String?
  // Set when the client signs the agreement — freezes the snapshot layer (SnapCustomer,
  // internal items, pricing). After this, only vendor items stay editable (ops swap);
  // changing internal items / price / pax requires a new revision + re-approval.
  snapshotFrozenAt      DateTime?
  // Revenue recognition (PSAK 72 / IFRS 15) — properti event/booking, BUKAN per-row Ledger.
  // null = unearned; terisi = pendapatan diakui (event selesai + approval). Manual finance action.
  recognizedAt          DateTime?
  recognizedById        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  sales               Profile?             @relation("BookingSales", fields: [salesId], references: [id], onDelete: Restrict)
  manager             Profile?             @relation("BookingManager", fields: [managerId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  venue               Venue                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  package             Package?             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentMethod       PaymentMethod?       @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  sourceOfInformation SourceOfInformation? @relation(fields: [sourceOfInformationId], references: [id], onDelete: SetNull)
  currentRevision     BookingRevision?     @relation("BookingCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  lead                DailyActivity?       @relation("BookingFromLead", fields: [leadId], references: [id], onDelete: SetNull)
  recognizedBy        Profile?             @relation("BookingRecognizer", fields: [recognizedById], references: [id], onDelete: SetNull)

  // Snapshot relations (1:1)
  snapCustomer       SnapCustomer?
  snapVenue          SnapVenue?
  snapPackage        SnapPackage?
  snapPackagePricing SnapPackagePricing?

  // Snapshot relations (1:many)
  snapPackageInternalItems  SnapPackageInternalItem[]
  snapPackageVendorItems    SnapPackageVendorItem[]
  snapPackageCategoryPrices SnapPackageCategoryPrice[]
  snapBonuses               SnapBonus[]
  snapVendorItems           SnapVendorItem[]
  snapComplimentaries       SnapComplimentary[]

  // Live relations
  termOfPayments     TermOfPayment[]
  ledgers            Ledger[]
  invoices           Invoice[]
  bookingDocuments   BookingDocument[]
  bookingRefunds     BookingPaymentSettlement[] @relation("SourceSettlements")
  targetSettlements  BookingPaymentSettlement[] @relation("TargetSettlements")
  clientAgreement    ClientAgreement?
  bookingComments    BookingComment[]
  commentReads       BookingCommentRead[]
  revisions          BookingRevision[]
  convertedFromLeads DailyActivity[]            @relation("LeadConvertedBooking")
  editDraft          BookingEditDraft?
  eventEvaluations   EventEvaluation[]
  creditBalance      CreditBalance?
  bookingPayables    BookingPayable[]

  @@index([salesId])
  @@index([managerId])
  @@index([customerId])
  @@index([venueId])
  @@index([packageId])
  @@index([paymentMethodId])
  @@index([sourceOfInformationId])
  @@index([leadId])
  @@index([bookingStatus])
  @@index([recordStatus])
  @@index([category])
  @@index([eventDate])
  @@index([currentRevisionId])
  @@index([recordStatus, poYear, poSeq])
  @@index([recognizedById])
  @@map("bookings")
}

