  approver1           Profile?                    @relation("RecruitmentRequestApprover1", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2           Profile?                    @relation("RecruitmentRequestApprover2", fields: [approver2Id], references: [id], onDelete: SetNull)
  formLink            RecruitmentFormLink?

  @@index([status])
  @@index([departmentId])
  @@index([requestedById])
  @@map("recruitment_requests")
}

// --- Recruitment Form Link ---------------------------------------------------

model RecruitmentFormLink {
  id                    String                      @id @default(uuid())
  recruitmentRequestId  String                      @unique
  token                 String                      @unique
  accessCode            String
  status                RecruitmentFormLinkStatus    @default(Active)
  viewedAt              DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  recruitmentRequest    RecruitmentRequest          @relation(fields: [recruitmentRequestId], references: [id], onDelete: Cascade)
  submissions           CandidateSubmission[]

  @@index([token])
  @@map("recruitment_form_links")
}

enum RecruitmentFormLinkStatus {
  Active
  Revoked
}

// --- Candidate Submission ----------------------------------------------------

model CandidateSubmission {
  id                    String                      @id @default(uuid())
  formLinkId            String
  fullName              String
  email                 String
  phoneNumber           String
  address               String?
  birthPlace            String?
  birthDate             DateTime?
  lastEducation         String?
  major                 String?
  workExperienceYears   Int?
  workHistory           String?
  cvUrl                 String?
  photoUrl              String?
  submittedAt           DateTime                    @default(now())
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  formLink              RecruitmentFormLink          @relation(fields: [formLinkId], references: [id], onDelete: Cascade)

  @@index([formLinkId])
  @@map("candidate_submissions")
}

// --- Blacklist ---------------------------------------------------------------

model BlacklistEntry {
  id              String   @id @default(uuid())
  fullName        String
  email           String?
  phoneNumber     String?
  reason          String
  blacklistedById String?
  blacklistedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blacklistedBy   Profile? @relation("BlacklistCreator", fields: [blacklistedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("blacklist_entries")
}

// --- Guestbook ---------------------------------------------------------------

model GuestbookEntry {
  id              String            @id @default(uuid())
  visitorName     String
  company         String?
  email           String?
  phoneNumber     String?
  idNumber        String?
  visitorPhotoUrl String?
  idPhotoUrl      String?
  purpose         GuestVisitPurpose @default(other)
  purposeNote     String?
  hostId          String?
  venueId         String?
  numberOfGuests  Int               @default(1)
  checkInAt       DateTime          @default(now())
  checkOutAt      DateTime?
  notes           String?
  guestCode       String?           @unique
  visitStatus     GuestVisitStatus?
  notJoinReason   String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  host            Profile?          @relation("GuestbookHost", fields: [hostId], references: [id], onDelete: SetNull)
  createdBy       Profile?          @relation("GuestbookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  venue           Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([checkInAt])
  @@index([hostId])
  @@index([venueId])
  @@map("guestbook_entries")
}

// --- Module Grouping -----------------------------------------------------------

model Module {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionMaps ModulePermissionMap[]

  @@map("modules")
}

model ModulePermissionMap {
  id               String @id @default(cuid())
  moduleId         String
  module           Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissionModule String

  @@unique([moduleId, permissionModule])
  @@map("module_permission_maps")
}
