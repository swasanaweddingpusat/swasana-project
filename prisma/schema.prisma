// ─── Booking Live Tables ─────────────────────────────────────────────────────

// Fase 5: TOP = JADWAL termin murni (name/amount/dueDate). "Berapa
// sudah terbayar" DERIVED dari Ledger cash-in via PaymentAllocation (lib/queries/ledger.ts).
// Kolom pembayaran lama (paymentStatus/paymentEvidence/paymentMethodId/ackStatus/
// acknowledged*) + tabel PartialPayment sudah di-drop — sumbernya sekarang Ledger.
// FIX C Step 3: invoiceNumber kolom legacy juga sudah di-drop — invoice on-demand via Invoice entity.
model TermOfPayment {
  id          String              @id @default(uuid())
  bookingId   String
  name        String
  amount      Int
  dueDate     DateTime
  notes       String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
  invoices    Invoice[]

  @@index([bookingId])
  @@map("term_of_payments")
}

/// Materialized overpayment (kelebihan bayar) per booking, in integer IDR.
/// amount = max(0, Σ acked cash-in (gross) − net price owed). Always >= 0.
/// Recomputed transactionally on cash-in ack and on any price/schedule change.
/// A positive balance is later resolved by a refund (Ledger direction=out) or
/// re-allocation — that resolution is out of scope for this plan.
model CreditBalance {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

/// Kewajiban uang KELUAR ke CUSTOMER (akrual). Lahir `outstanding` (kas diam),
/// jadi `paid` saat AP disburse (kas keluar riil -> Ledger direction=out).
/// BUKAN cashbook — kewajiban-belum-bayar sengaja di LUAR Ledger (§7.1 ERD).
model BookingPayable {
  id                 String        @id @default(cuid())
  bookingId          String
  type               PayableType
  programId          String?
  sourceLedgerId     String?
  settlementLedgerId String?       @unique
  amount             Int
  status             PayableStatus @default(outstanding)
  paymentMethodId    String?
  disbursementNumber String?       @unique
  settledAt          DateTime?
  settledById        String?
  notes              String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  program          DiscountProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  sourceLedger     Ledger?          @relation("PayableSource", fields: [sourceLedgerId], references: [id], onDelete: SetNull)
  settlementLedger Ledger?          @relation("PayableSettlement", fields: [settlementLedgerId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?   @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  settledBy        Profile?         @relation("PayableSettler", fields: [settledById], references: [id], onDelete: SetNull)
  createdBy        Profile?         @relation("PayableCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
  @@index([programId])
  @@index([sourceLedgerId])
  @@index([paymentMethodId])
  @@map("booking_payables")
}

// ─── Cashflow Ledger (Buku Besar / Cashbook) ─────────────────────────────────
// Single-entry cashbook. Sekarang cuma direction=in (cash in). PartialPayment
// digeneralisasi ke sini. Revenue recognition ada di Booking.recognizedAt (bukan row ini).

model Ledger {
  id                    String              @id @default(uuid())
  bookingId             String
  direction             LedgerDirection     @default(in)
  // ackStatus = SUMBER KEBENARAN (verifikasi Finance). Gate AR & recognition.
  ackStatus             LedgerAckStatus     @default(pending)
  // paymentStatus = placeholder gateway. Manual transfer selalu "paid". Jangan dipakai logika.
  paymentStatus         LedgerPaymentStatus @default(paid)
  occurredAt            DateTime // tanggal transaksi (uang bergerak)
  amount                Int // GROSS — nominal yang meng-offset termin (§6.4)
  discountProgramId     String? // promo per-pembayaran (opsional)
  discountAmount        Int                 @default(0) // contra-revenue snapshot
  cashAmount            Int // uang riil masuk = amount - discountAmount
  paymentMethodId       String? // bank tujuan; null = Cash
  evidence              String? // storage path/key, BUKAN full URL (§7.1)
  invoiceNumber         String? // no. kwitansi auto-gen server (§7.2)
  notes                 String?
  // Tampilkan cash-in ini di section Summary Payment PO PDF. Default OFF —
  // user sengaja menyalakan per pembayaran. Voided tetap di-exclude saat render.
  showInPo              Boolean             @default(false)
  // Freeze konteks pembayaran (FIX B) — beku nama termin/package/venue SAAT
  // cash-in dibuat. Label PO/Invoice pakai ini FIRST, fallback live-join kalau
  // null (data lama pre-migrasi). Diisi sekali saat create, immutable setelahnya.
  snapTopName           String?
  snapPackageName       String?
  snapVenueName         String?
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  acknowledgedSignature String? // ttd Finance (data URL PNG), nullable
  // Void tombstone — koreksi non-destruktif (§6.5). Row tetap ada (konten finansial immutable),
  // cuma ditandai batal. Derived AR/query WAJIB exclude voidedAt != null.
  voidedAt              DateTime?
  voidedById            String?
  createdById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  discountProgram   DiscountProgram?    @relation(fields: [discountProgramId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  acknowledgedBy    Profile?            @relation("LedgerAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  voidedBy          Profile?            @relation("LedgerVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy         Profile?            @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  allocations       PaymentAllocation[]
  activities        PaymentActivity[]
  payableSource     BookingPayable[]    @relation("PayableSource")
  payableSettlement BookingPayable?     @relation("PayableSettlement")

  @@unique([invoiceNumber])
  @@index([bookingId, direction, ackStatus])
  @@index([discountProgramId])
  @@index([paymentMethodId])
  @@index([acknowledgedById])
  @@index([voidedById])
  @@index([createdById])
  @@map("ledgers")
}

// Join cash-in ↔ TermOfPayment + porsi GROSS yang meng-offset termin.
model PaymentAllocation {
  id        String   @id @default(uuid())
  ledgerId  String
  termId    String
  amount    Int // porsi GROSS cash-in yang offset termin ini (§6.4)
  // Tampilkan porsi alokasi ini (per termin) di section Summary Payment PO PDF.
  // Granular per-termin — satu cash-in bisa punya sebagian termin tampil, sebagian
  // tidak. Default OFF. Voided ledger tetap di-exclude saat render.
  showInPo  Boolean  @default(false)
  createdAt DateTime @default(now())

  ledger Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  term   TermOfPayment @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, termId])
  @@index([termId])
  @@index([ledgerId])
  @@map("payment_allocations")
}

// Log append-only per Ledger row (created → acknowledged/rejected → voided). Snapshot ttd.
model PaymentActivity {
  id                String                @id @default(uuid())
  ledgerId          String
  action            PaymentActivityAction
  actorId           String?
  actorNameSnapshot String // nama pelaku (denormalized, tahan hapus profil)
  signature         String? // data URL ttd — cuma keisi saat acknowledged
  note              String?
  createdAt         DateTime              @default(now())

  ledger Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  actor  Profile? @relation("PaymentActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ledgerId, createdAt])
  @@index([actorId])
  @@map("payment_activities")
}

// ─── Invoice (Tagihan Terbit) — FIX C ───────────────────────────────────────
// Cermin dari Ledger/kwitansi: TAGIHAN TERBIT immutable, terpisah dari
// TermOfPayment (jadwal, live/mutable). On-demand (finance trigger "Terbitkan
// Invoice"), 1 invoice = 1 termin. `amount` BEKU saat terbit (= termin.amount
// net saat itu — TIDAK dibaca live dari termin lagi). Void via tombstone,
// row tidak pernah dihapus; nomor void TIDAK dipakai ulang.
// termId nullable: termin boleh di-rebuild/dihapus (switch venue) tanpa
// merusak invoice yang sudah terbit — invoice jadi yatim tapi utuh sbg
// dokumen historis (docs/superpowers/specs/2026-07-14-booking-money-model.md §6.3).
model Invoice {
  id            String        @id @default(uuid())
  bookingId     String
  termId        String?
  invoiceNumber String
  invoiceType   InvoiceType   @default(progress)
  amount        Int // BEKU (net) saat terbit = snapshot termin.amount
  dueDate       DateTime?
  notes         String?
  status        InvoiceStatus @default(issued)
  issuedAt      DateTime      @default(now())
  issuedById    String?
  voidedAt      DateTime?
  voidedById    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  term     TermOfPayment? @relation(fields: [termId], references: [id], onDelete: SetNull)
  issuedBy Profile?       @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  voidedBy Profile?       @relation("InvoiceVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([invoiceNumber])
  @@index([bookingId])
  @@index([termId])
  @@index([status])
  @@map("invoices")
}

