# ============================================
# DATABASE
# ============================================
# DB driver toggle:
#   true  → Neon serverless adapter (pooled HTTP) — for Neon-hosted Postgres
#   false → native PostgreSQL connection — for self-hosted Postgres (Docker/VPS)
DB_NEON=true

# Pooled connection (PgBouncer) — used by the runtime app
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
# Direct connection (no -pooler in host) — used by Prisma CLI / migrations
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# For self-hosted Postgres (DB_NEON=false) both URLs point to the same host, e.g.:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"
#   DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"

# ============================================
# NEXTAUTH v5
# ============================================
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Swasana Wedding <noreply@yourdomain.com>"

# ============================================
# STORAGE (Cloudflare R2)
# ============================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="swasana-storage"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ============================================
# ADMIN API
# ============================================
CLEANUP_SECRET="your-cleanup-secret-here"

# TanStack Query Devtools (set to "true" to enable)
NEXT_PUBLIC_SHOW_DEVTOOLS=false

# ============================================
# E-METERAI (Peruri)
# ============================================
PERURI_USERNAME=
PERURI_PASSWORD=
PERURI_ENV=staging
