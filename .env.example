# ============================================
# DATABASE
# ============================================
# DB driver toggle:
#   true  → Neon serverless adapter (pooled HTTP) — for Neon-hosted Postgres
#   false → native PostgreSQL connection — for self-hosted Postgres (Docker/VPS)
DB_NEON=true

# Pooled connection (PgBouncer) — used by the runtime app
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"
# Direct connection (no -pooler in host) — used by Prisma CLI / migrations
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# For self-hosted Postgres (DB_NEON=false) both URLs point to the same host, e.g.:
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"
#   DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"
# On Dokploy use the Postgres service INTERNAL host (no public expose needed):
#   DATABASE_URL="postgresql://user:password@<internal-host>:5432/dbname?sslmode=disable"
#   DIRECT_URL="postgresql://user:password@<internal-host>:5432/dbname?sslmode=disable"
# See docs/DEPLOYMENT.md for the full Dokploy setup + per-environment env list.

# ============================================
# NEXTAUTH v5
# ============================================
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
# Public base URL of the app (used by Auth.js for callback URLs).
# Set to the deployed domain in staging/production, e.g. https://app.swasana.com
AUTH_URL="http://localhost:3000"
# Required when running behind a reverse proxy (Dokploy/Traefik). Set to "true"
# in any containerized/proxied deployment, otherwise Auth.js may reject callbacks.
AUTH_TRUST_HOST=true

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Swasana Wedding <noreply@yourdomain.com>"

# ============================================
# STORAGE (MinIO / S3-compatible)
# ============================================
S3_ENDPOINT="https://your-minio-host.railway.app"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_BUCKET_NAME="swasana-storage"
S3_PUBLIC_URL="https://your-minio-host.railway.app/swasana-storage"
NEXT_PUBLIC_S3_PUBLIC_URL="https://your-minio-host.railway.app/swasana-storage"

# ============================================
# ADMIN API
# ============================================
CLEANUP_SECRET="your-cleanup-secret-here"

# TanStack Query Devtools (set to "true" to enable)
NEXT_PUBLIC_SHOW_DEVTOOLS=false

# ============================================
# PWA / PUSH NOTIFICATIONS
# ============================================
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@swasana.com

# ============================================
# E-METERAI (Peruri)
# ============================================
PERURI_USERNAME=
PERURI_PASSWORD=
PERURI_ENV=staging

# ============================================
# BITRIX24 CRM
# ============================================
# Inbound webhook base URL (Developer resources -> Other -> Inbound webhook)
BITRIX_WEBHOOK_BASE=https://your-domain.bitrix24.id/rest/USER_ID/WEBHOOK_TOKEN/

# ============================================
# REDIS (Bitrix resilience cache)
# ============================================
# Master switch. Default OFF: the Bitrix cache silently no-ops and every read
# hits Bitrix live unless this is EXACTLY "true". Turn on per environment
# (production on; staging/local opt-in). Redis only activates when this is
# "true" AND REDIS_URL is set.
REDIS_ENABLED=false
# Connection string. Required only when REDIS_ENABLED=true.
# On Railway: add a Redis service, then reference it here: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=
# Secret guarding the daily warmer endpoint GET /api/cron/bitrix-refresh.
# Generate a DEDICATED secret (openssl rand -base64 32) — do NOT reuse AUTH_SECRET/CLEANUP_SECRET.
BITRIX_CRON_SECRET=

# ── Claude via 9router (AI baca nomor PO dari dokumen upload) ──────────────────
# Gateway 9router (BYO key) — SAMA dengan yang dipakai tooling CLI. Endpoint harus
# Anthropic-native (/v1/messages). Kalau kosong, fitur auto-baca nomor PO nonaktif
# (staff tetap bisa isi Nomor PO manual seperti biasa).
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=            # Bearer token 9router. (alternatif: ANTHROPIC_API_KEY untuk x-api-key)
PO_EXTRACT_MODEL=claude-sonnet-5 # model buat baca dokumen (default Sonnet 5)
