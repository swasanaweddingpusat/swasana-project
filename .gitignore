# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ad-hoc build output dumps (e.g. `npm run build > build-check.txt`) — never commit
build-check*.txt

# env files (can opt-in for committing if needed)
.env
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kiro
Screenshot*.png

.superpowers/
.claude/
docs/superpowers/

# external API references (not part of swasana-project)
/API On Cloud V.1.3/
/API On Premis V.1.3/

# DB backups / production data dumps — never commit (contains PII & tokens)
/scripts/backups/

# Throwaway/ad-hoc dev & migration scripts (DB clone, MinIO tests, investigations) — not for repo
/scripts/_*
/prisma/seeders/_*
# Exception: _client.ts is a real shared dependency imported by every seeder — must be tracked
!/prisma/seeders/_client.ts


scripts/
